# LLM Compare — copy to .env (or just use the Admin page, which writes this file).
# Same variable names as the Lesson 2 code, so you can reuse that .env as-is.
# A provider appears in the UI once its credentials are set.
# Every *_MODEL_ID may hold several comma-separated IDs; each becomes its own entry.
# Leave a *_MODEL_ID empty to use the built-in default models (see README).

# Password for the Admin page. Leave empty to choose one on first visit.
ADMIN_PASSWORD=

# --- AWS Bedrock ---------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Use the cross-region inference-profile ID (the `us.` one)
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# --- NVIDIA (OpenAI-compatible) ---------------------------------------------------
# https://build.nvidia.com/settings/api-keys (starts with nvapi-)
NVIDIA_API_KEY=
NVIDIA_MODEL_ID=nvidia/nemotron-3-super-120b-a12b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Google Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite

# --- OpenAI -----------------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL_ID=
# OPENAI_BASE_URL=

# --- xAI Grok (OpenAI-compatible) --------------------------------------------------
# https://console.x.ai
GROK_API_KEY=
GROK_MODEL_ID=grok-4
# GROK_BASE_URL=https://api.x.ai/v1

# --- Anthropic --------------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=
# Only for keys not scoped to a workspace (the API then asks for the
# anthropic-workspace-id header). Console → Settings → Workspaces → ID column.
ANTHROPIC_WORKSPACE_ID=
